APP_NAME=trace-rag-local
APP_ENV=local
LOG_LEVEL=INFO

# Local-only examples. Replace every key in deployed environments.
ADMIN_API_KEYS=dev-admin-key
# Format: api_key:user_id:group1,group2;another_key:user2:group2
USER_API_KEYS=dev-user-key:user-1:default
AUTH_PROVIDER_PLACEHOLDER=
CORS_ALLOWED_ORIGINS=http://localhost:3000

RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=
RATE_LIMIT_WINDOW_SECONDS=
RATE_LIMIT_BACKEND=
REDIS_URL=

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=sqlite:///./trace.db

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# In APP_ENV=local, replace-me enables deterministic local AI for offline smoke tests.
# Set a real key in production using platform secrets, never in git.
OPENAI_API_KEY=replace-me
OPENAI_EMBEDDING_MODEL=
OPENAI_CHAT_MODEL=
EMBEDDING_DIMENSION=
ESTIMATED_INPUT_COST_PER_1M_TOKENS=
ESTIMATED_OUTPUT_COST_PER_1M_TOKENS=

MAX_UPLOAD_MB=
CHUNK_SIZE_TOKENS=
CHUNK_OVERLAP_TOKENS=
RETRIEVAL_TOP_K=
MIN_RETRIEVAL_SCORE=
RETRIEVAL_MODE=
VECTOR_SEARCH_WEIGHT=
KEYWORD_SEARCH_WEIGHT=
HYBRID_RRF_K=
HYBRID_CANDIDATE_MULTIPLIER=
RERANKING_ENABLED=
RERANKER_PROVIDER=
RERANK_TOP_K=
LOCAL_RERANKER_LEXICAL_WEIGHT=
MIN_CITATION_SCORE=
REQUEST_TIMEOUT_SECONDS=
UPLOAD_READ_CHUNK_BYTES=
MAX_CONTEXT_CHARS=
OPENAI_MAX_RETRIES=

LANGFUSE_ENABLED=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
